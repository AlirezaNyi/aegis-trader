# Aegis environment placeholders — never commit real secrets.

# development | paper | live  (default: paper)
AEGIS_TRADING_MODE=paper

# Explicit live arm (required with live mode). Default: false
AEGIS_LIVE_ARMED=false

# When true, block new orders. Default: false
AEGIS_KILL_SWITCH=false

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# Toobit credentials — leave empty for paper/dev. Never commit real values.
TOOBIT_API_KEY=
TOOBIT_API_SECRET=

# TypeSafe Jev — optional; UnavailableJevPort when empty
TYPESAFE_API_KEY=

# Jev System One transport bounds (engineering; not risk-policy numbers)
# AEGIS_JEV_TIMEOUT_SECONDS=10
# AEGIS_JEV_MAX_RETRIES=1
# AEGIS_JEV_MODEL=jev-latest

# LLM provider — optional until owner selects a provider (UNAPPROVED)
AEGIS_LLM_PROVIDER=
AEGIS_LLM_API_KEY=
AEGIS_LLM_MODEL=

# Supervisor LLM call bounds — leave empty to fail closed (no real LLM call)
# AEGIS_SUPERVISOR_TIMEOUT_SECONDS=15
# AEGIS_LLM_TOKEN_BUDGET=
# AEGIS_LLM_COST_BUDGET=
# AEGIS_LLM_LATENCY_BUDGET_MS=

# Risk policy version — 1.0 = owner-approved snapshot; 0.1-draft = all UNAPPROVED
# AEGIS_RISK_POLICY_VERSION=1.0

# Logging
AEGIS_LOG_LEVEL=INFO

# Phase 3 analyst orchestration bounds
AEGIS_ANALYST_TIMEOUT_SECONDS=2
AEGIS_ANALYST_CONCURRENCY=5

# Phase 6 paper/backtest simulation assumptions (NOT risk policy)
# AEGIS_PAPER_FEE_BPS=10
# AEGIS_PAPER_SLIPPAGE_BPS=5

# Paper soak runner (engineering; default off; public MD only; never arms live)
# AEGIS_PAPER_SOAK_ENABLED=false
# AEGIS_PAPER_SOAK_SYMBOL=ADAUSDT
# AEGIS_PAPER_SOAK_INTERVAL=1m
# AEGIS_PAPER_SOAK_POLL_SECONDS=30

# Phase 7 exchange transport bounds (engineering; not risk-policy numbers)
# AEGIS_EXCHANGE_RECV_WINDOW_MS=5000
# AEGIS_EXCHANGE_TIMEOUT_SECONDS=10
