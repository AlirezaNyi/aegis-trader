# Aegis environment placeholders — never commit real secrets.

# development | paper | live  (default: paper)
AEGIS_TRADING_MODE=paper

# Explicit live arm (required with live mode). Default: false
AEGIS_LIVE_ARMED=false

# When true, block new orders. Default: false
AEGIS_KILL_SWITCH=false

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# Toobit credentials — leave empty for paper/dev. Never commit real values.
TOOBIT_API_KEY=
TOOBIT_API_SECRET=

# TypeSafe Jev — optional; mock used when empty
TYPESAFE_API_KEY=

# LLM provider — optional until owner selects a provider
AEGIS_LLM_PROVIDER=
AEGIS_LLM_API_KEY=
AEGIS_LLM_MODEL=

# Logging
AEGIS_LOG_LEVEL=INFO

# Phase 3 analyst orchestration bounds
AEGIS_ANALYST_TIMEOUT_SECONDS=2
AEGIS_ANALYST_CONCURRENCY=5
